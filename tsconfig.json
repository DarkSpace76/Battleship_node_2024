{
    "compilerOptions": {
        "target": "ES2020",
        "module": "es2020",
        "baseUrl": "./",
        "paths": {
            "src/*": [
                "src/*"
            ]
        },
        "outDir": "./dist",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitAny": false,
        "strictNullChecks": false,
        "skipLibCheck": true,
        "moduleResolution": "node",
    },
    "include": [
        "./**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}